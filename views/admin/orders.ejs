<section class="admin-shell">
  <%- include('nav') %>
  <div class="admin-content">
    <div class="section-head">
      <div><p class="eyebrow">CRM</p><h1>Заказы и оплаты</h1></div>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Заказ</th><th>Клиент</th><th>Состав</th><th>Сумма</th><th>Статус</th><th>Платеж</th></tr></thead>
        <tbody>
          <% orders.forEach((order) => { %>
            <tr>
              <td>#<%= order.id %><br><small><%= order.createdAt.toLocaleString('ru-RU') %></small></td>
              <td><%= order.customer %><br><small><%= order.phone %></small></td>
              <td>
                <% order.items.forEach((item) => { %>
                  <span><%= item.product.title %> × <%= item.quantity %></span><br>
                <% }) %>
              </td>
              <td><%= money(order.total) %></td>
              <td><%= orderStatusLabel(order.status) %></td>
              <td><%= order.payments[0]?.reference || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>

