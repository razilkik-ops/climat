<section class="admin-shell">
  <%- include('nav') %>
  <div class="admin-content">
    <div class="section-head">
      <div>
        <p class="eyebrow">Админка</p>
        <h1>Управление каталогом</h1>
      </div>
      <% if (mode === 'edit') { %>
        <a class="button button-outline" href="/admin/products">Новый товар</a>
      <% } %>
    </div>

    <form
      action="<%= mode === 'edit' ? `/admin/products/${product.id}?_method=PATCH` : '/admin/products' %>"
      method="post"
      class="admin-product-form"
    >
      <div class="form-grid wide">
        <label>Название<input name="title" value="<%= product?.title || '' %>" required></label>
        <label>Slug<input name="slug" value="<%= product?.slug || '' %>" placeholder="создастся из названия"></label>
        <label>Бренд
          <select name="brandId" required>
            <% brands.forEach((brand) => { %>
              <option value="<%= brand.id %>" <%= product?.brandId === brand.id ? 'selected' : '' %>><%= brand.name %></option>
            <% }) %>
          </select>
        </label>
        <label>Тип
          <select name="type">
            <% [['split','Сплит'], ['designer','Дизайнерский'], ['commercial','Коммерческий']].forEach(([value, label]) => { %>
              <option value="<%= value %>" <%= (product?.type || 'split') === value ? 'selected' : '' %>><%= label %></option>
            <% }) %>
          </select>
        </label>
        <label>Площадь, м²<input type="number" name="roomArea" value="<%= product?.roomArea || 25 %>" min="10" required></label>
        <label>Мощность, кВт<input type="number" step="0.1" name="coolingPower" value="<%= product?.coolingPower || 2.5 %>" min="1" required></label>
        <label>Шум, дБ<input type="number" name="noiseLevel" value="<%= product?.noiseLevel || 20 %>" min="16" required></label>
        <label>Класс<input name="energyClass" value="<%= product?.energyClass || 'A++' %>" required></label>
        <label>Цена, BYN<input type="number" name="price" value="<%= product?.price || 1990 %>" min="0" required></label>
        <label>Монтаж, BYN<input type="number" name="installPrice" value="<%= product?.installPrice || 520 %>" min="0" required></label>
        <label>Рейтинг<input type="number" step="0.1" name="rating" value="<%= product?.rating || 4.8 %>" min="1" max="5"></label>
        <label>Остаток<input type="number" name="stock" value="<%= product?.stock || 0 %>" min="0"></label>
        <label>Бейдж<input name="badge" value="<%= product?.badge || '' %>" placeholder="Хит, Wi‑Fi, Премиум"></label>
        <label>Изображение<input name="image" value="<%= product?.image || '/img/ac-white.svg' %>" required></label>
      </div>
      <label>Описание<textarea name="description" rows="3" required><%= product?.description || '' %></textarea></label>
      <label>Характеристики и преимущества<textarea name="features" rows="3" placeholder="Каждую характеристику с новой строки"><%= Array.isArray(product?.features) ? product.features.join('\n') : '' %></textarea></label>
      <div class="admin-form-actions">
        <label class="check"><input type="checkbox" name="inverter" <%= product?.inverter !== false ? 'checked' : '' %>> Инвертор</label>
        <label class="check"><input type="checkbox" name="wifi" <%= product?.wifi ? 'checked' : '' %>> Wi‑Fi</label>
        <button class="button button-primary" type="submit"><%= mode === 'edit' ? 'Сохранить товар' : 'Добавить товар' %></button>
      </div>
    </form>

    <div class="table-wrap catalog-admin-table">
      <table>
        <thead><tr><th>Модель</th><th>Бренд</th><th>Площадь</th><th>Цена</th><th>Остаток</th><th></th></tr></thead>
        <tbody>
          <% products.forEach((entry) => { %>
            <tr>
              <td><a href="/product/<%= entry.slug %>"><%= entry.title %></a><br><small><%= entry.type %> · <%= entry.energyClass %></small></td>
              <td><%= entry.brand.name %></td>
              <td><%= entry.roomArea %> м²</td>
              <td><%= money(entry.price) %></td>
              <td><%= entry.stock %></td>
              <td class="table-actions">
                <a class="button button-outline" href="/admin/products/<%= entry.id %>/edit">Править</a>
                <form action="/admin/products/<%= entry.id %>?_method=DELETE" method="post">
                  <button class="button button-outline" type="submit">Удалить</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>
