<section class="admin-login">
  <form action="/admin/login" method="post" class="smart-form auth-form">
    <p class="eyebrow">Админка</p>
    <h1>Вход в CRM</h1>
    <% if (error) { %><p class="form-error"><%= error %></p><% } %>
    <label>Email<input type="email" name="email" value="admin@climate.by" required></label>
    <label>Пароль<input type="password" name="password" value="admin123" required></label>
    <button class="button button-dark" type="submit">Войти</button>
  </form>
</section>

