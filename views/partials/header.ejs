<header class="site-header">
  <div class="header-top">
    <a class="brand" href="/" aria-label="CLIMAT">
      <span class="brand-mark">✣</span>
      <strong>CLIMAT</strong>
    </a>
    <div class="header-contact">
      <a class="phone" href="tel:+375291234567">+375 (29) 123-45-67</a>
      <a class="call-link" href="/quiz">Заказать звонок</a>
    </div>
    <div class="header-icons">
      <a class="round-icon" href="/quiz" aria-label="Подбор">↗</a>
      <a class="round-icon" href="/compare" data-compare-link aria-label="Сравнение">♡</a>
      <a class="round-icon" href="/admin/login" aria-label="Аккаунт">◎</a>
      <a class="round-icon cart-link" href="/cart" aria-label="Корзина">⌑<span data-cart-count>0</span></a>
    </div>
    <button class="icon-button menu-toggle" type="button" data-menu-toggle aria-label="Меню">
      <span></span>
      <span></span>
    </button>
  </div>
  <div class="header-bottom">
    <p>Продажа и профессиональная установка кондиционеров в Минске</p>
    <nav class="main-nav" data-menu>
      <a href="/catalog" class="<%= currentPath.startsWith('/catalog') ? 'active' : '' %>">Каталог</a>
      <a href="/installation" class="<%= currentPath.startsWith('/installation') ? 'active' : '' %>">Монтаж</a>
      <a href="/quiz" class="<%= currentPath.startsWith('/quiz') ? 'active' : '' %>">Подбор</a>
      <a href="/calculator" class="<%= currentPath.startsWith('/calculator') ? 'active' : '' %>">Калькулятор</a>
      <a href="/warranty" class="<%= currentPath.startsWith('/warranty') ? 'active' : '' %>">Компания</a>
      <a href="#contacts">Контакты</a>
      <% if (admin) { %>
        <a href="/admin">CRM</a>
      <% } %>
    </nav>
    <a class="button button-primary" href="/quiz">Подобрать кондиционер <span>→</span></a>
  </div>
</header>
