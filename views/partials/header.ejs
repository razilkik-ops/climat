<header class="site-header">
  <div class="header-top">
    <a class="brand" href="/" aria-label="CLIMAT">
      <span class="brand-mark">✣</span>
      <strong>CLIMAT</strong>
    </a>
    <div class="header-contact">
      <a class="phone" href="tel:+375291234567">+375 (29) 123-45-67</a>
      <a class="call-link" href="/quiz">Заказать звонок</a>
    </div>
    <div class="header-icons">
      <span class="round-icon header-disabled-icon" aria-label="Подбор" aria-disabled="true"><span class="ui-icon icon-arrow-up"></span></span>
      <a class="round-icon" href="/compare" data-compare-link aria-label="Сравнение"><span class="ui-icon icon-heart"></span></a>
      <a class="round-icon cart-link" href="/cart" aria-label="Корзина"><span class="ui-icon icon-cart"></span><span data-cart-count>0</span></a>
    </div>
    <button class="icon-button menu-toggle" type="button" data-menu-toggle aria-label="Меню">
      <span></span>
      <span></span>
    </button>
  </div>
  <div class="header-bottom">
    <p>Продажа и профессиональная установка кондиционеров в Минске</p>
    <nav class="main-nav" data-menu>
      <a href="/catalog" class="<%= currentPath.startsWith('/catalog') || currentPath.startsWith('/product') ? 'active' : '' %>">Каталог</a>
      <a href="/installation" class="<%= currentPath.startsWith('/installation') ? 'active' : '' %>">Монтаж</a>
      <span class="nav-disabled" aria-disabled="true">Подбор</span>
      <span class="nav-disabled" aria-disabled="true">Калькулятор</span>
      <a href="/warranty" class="<%= currentPath.startsWith('/warranty') ? 'active' : '' %>">Компания</a>
      <span class="nav-disabled" aria-disabled="true">Контакты</span>
      <% if (currentUser) { %>
        <a href="/account" class="<%= currentPath.startsWith('/account') ? 'active' : '' %>">Кабинет</a>
      <% } else { %>
        <a href="/login" class="<%= currentPath.startsWith('/login') || currentPath.startsWith('/register') ? 'active' : '' %>">Вход</a>
      <% } %>
    </nav>
    <span class="button button-primary header-disabled-cta" aria-disabled="true">Подобрать кондиционер <span>→</span></span>
  </div>
</header>
