<article class="product-card reveal">
  <% if (product.badge) { %><span class="badge"><%= product.badge %></span><% } %>
  <a href="/product/<%= product.slug %>" class="product-media">
    <img src="<%= product.image %>" alt="<%= product.title %>" loading="lazy">
  </a>
  <div class="product-body">
    <a href="/product/<%= product.slug %>" class="muted"><%= product.brand.name %></a>
    <h3><a href="/product/<%= product.slug %>"><%= product.title %></a></h3>
    <p>Площадь: до <%= product.roomArea %> м²</p>
    <div class="product-bottom">
      <strong><%= money(product.price) %></strong>
      <div class="card-actions">
        <button class="round-icon compare-toggle" type="button" data-compare-id="<%= product.id %>" aria-label="Добавить к сравнению">♡</button>
        <button
          class="round-icon cart-add"
          type="button"
          data-cart-add
          data-id="<%= product.id %>"
          data-title="<%= product.title %>"
          data-slug="<%= product.slug %>"
          data-price="<%= product.price %>"
          data-install-price="<%= product.installPrice %>"
          data-image="<%= product.image %>"
          data-brand="<%= product.brand.name %>"
          aria-label="Добавить в корзину"
        >⌑</button>
      </div>
    </div>
  </div>
</article>
