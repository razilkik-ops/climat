<section class="page-title">
  <p class="eyebrow">Квиз-подбор</p>
  <h1>Подберем кондиционер под комнату, а не по красивой коробке</h1>
</section>

<section class="form-shell">
  <form action="/quiz" method="post" class="smart-form">
    <label>Тип объекта
      <select name="objectType">
        <option>Квартира</option>
        <option>Дом</option>
        <option>Офис</option>
        <option>Коммерческое помещение</option>
      </select>
    </label>
    <label>Площадь помещения, м²<input type="number" name="area" min="10" max="120" value="25" required></label>
    <label>Длина трассы, м<input type="number" name="routeLength" min="3" max="25" value="3"></label>
    <label>Уровень решения
      <select name="tier">
        <option value="balanced">Баланс цена/ресурс</option>
        <option value="economy">Экономично</option>
        <option value="premium">Премиум и тишина</option>
      </select>
    </label>
    <label class="check"><input type="checkbox" name="wifi"> Нужен Wi-Fi</label>
    <div class="form-grid">
      <label>Имя<input name="name" placeholder="Ваше имя"></label>
      <label>Телефон<input name="phone" placeholder="+375..."></label>
    </div>
    <button class="button button-dark" type="submit">Показать рекомендацию</button>
  </form>
</section>

