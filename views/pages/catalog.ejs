<section class="catalog-screen">
  <aside class="filters catalog-filters">
    <div class="filters-title">
      <h2>Фильтры</h2>
      <span class="ui-icon icon-sliders"></span>
    </div>
    <form method="get" action="/catalog">
      <label>Бренд
        <select name="brand">
          <option value="">Все бренды</option>
          <% brands.forEach((brand) => { %>
            <option value="<%= brand.slug %>" <%= query.brand === brand.slug ? 'selected' : '' %>><%= brand.name %></option>
          <% }) %>
        </select>
      </label>
      <label>Тип
        <select name="type">
          <option value="">Все типы</option>
          <option value="split" <%= query.type === 'split' ? 'selected' : '' %>>Сплит</option>
          <option value="designer" <%= query.type === 'designer' ? 'selected' : '' %>>Дизайнерские</option>
          <option value="commercial" <%= query.type === 'commercial' ? 'selected' : '' %>>Офисные</option>
        </select>
      </label>
      <div class="range-field">
        <span>Площадь, м²</span>
        <div>
          <input type="number" name="minArea" value="<%= query.minArea || query.area || '' %>" min="10" max="120" placeholder="от">
          <input type="number" name="maxArea" value="<%= query.maxArea || '' %>" min="10" max="120" placeholder="до">
        </div>
      </div>
      <div class="range-field">
        <span>Цена, BYN</span>
        <div>
          <input type="number" name="minPrice" value="<%= query.minPrice || '' %>" min="0" placeholder="от">
          <input type="number" name="maxPrice" value="<%= query.maxPrice || '' %>" min="0" placeholder="до">
        </div>
      </div>
      <label>Сортировка
        <select name="sort">
          <option value="rating" <%= query.sort === 'rating' ? 'selected' : '' %>>По рейтингу</option>
          <option value="price_asc" <%= query.sort === 'price_asc' ? 'selected' : '' %>>Сначала дешевле</option>
          <option value="price_desc" <%= query.sort === 'price_desc' ? 'selected' : '' %>>Сначала дороже</option>
          <option value="area" <%= query.sort === 'area' ? 'selected' : '' %>>По площади</option>
        </select>
      </label>
      <label class="check"><input type="checkbox" name="inverter" <%= query.inverter === 'on' ? 'checked' : '' %>> Инвертор</label>
      <label class="check"><input type="checkbox" name="wifi" <%= query.wifi === 'on' ? 'checked' : '' %>> Wi‑Fi</label>
      <button class="button button-primary" type="submit">Применить</button>
      <a class="button button-outline reset-link" href="/catalog">Сбросить</a>
    </form>
  </aside>

  <div class="catalog-main">
    <div class="catalog-topline">
      <div class="catalog-title-row">
        <h1>Кондиционеры</h1>
        <span><%= products.length %> моделей</span>
      </div>
      <div class="catalog-actions">
        <a class="button button-outline compare-action" href="/compare" data-compare-link><span class="ui-icon icon-scale"></span>Сравнить 2 модели</a>
      </div>
    </div>

    <nav class="catalog-chips" aria-label="Быстрые фильтры">
      <a class="active" href="/catalog">Все модели</a>
      <a href="/catalog?type=designer">Дизайн</a>
      <a href="/catalog?sort=price_desc">Премиум</a>
      <a href="/catalog?sort=rating">Тихий выбор</a>
      <a href="/catalog?type=commercial">Для офиса</a>
      <a href="/catalog?wifi=on">Зима/лето</a>
      <a href="/catalog?sort=price_asc">Оптимально</a>
    </nav>

    <div class="catalog-grid">
      <% products.forEach((product) => { %>
        <%- include('../partials/product-card', { product }) %>
      <% }) %>
    </div>
    <% if (!products.length) { %>
      <div class="empty-state">
        <h2>По фильтрам ничего не найдено</h2>
        <p>Сбросьте часть параметров или оставьте заявку, и менеджер подберет альтернативы.</p>
        <a class="button button-primary" href="/quiz">Подобрать через квиз</a>
      </div>
    <% } %>
  </div>
</section>

<section class="catalog-benefits">
  <div><span class="ui-icon icon-search"></span><strong>Бесплатный подбор</strong><small>за 15 минут</small></div>
  <div><span class="ui-icon icon-tools"></span><strong>Профессиональный монтаж</strong><small>от 1 дня</small></div>
  <div><span class="ui-icon icon-shield"></span><strong>Гарантия до 5 лет</strong><small>на оборудование и работы</small></div>
  <div><span class="ui-icon icon-tag"></span><strong>Честные цены</strong><small>без скрытых платежей</small></div>
</section>
