<section class="hero shop-hero dark-hero">
  <div class="hero-copy reveal">
    <span class="location-pill">⌂ Работаем в Минске и области</span>
    <h1>Климат,<br><span class="h1-muted">который создаёт</span><br><span>комфорт</span></h1>
    <p>Продажа и профессиональная установка кондиционеров в Минске. Подберём, установим и обеспечим сервисное обслуживание.</p>
    <div class="hero-actions">
      <a class="button button-primary" href="/quiz">Подобрать кондиционер <span>→</span></a>
      <a class="button button-outline" href="/calculator">Рассчитать стоимость <span>⌑</span></a>
    </div>
  </div>

  <div class="hero-visual reveal" aria-hidden="true">
    <div class="conditioner-unit dark-unit">
      <div class="unit-display">23°</div>
      <div class="unit-brand">CLIMAT</div>
      <div class="unit-slit"></div>
      <div class="cool-flow"></div>
      <div class="cool-flow flow-two"></div>
      <div class="cool-flow flow-three"></div>
    </div>
  </div>

  <div class="hero-features">
    <div><b>✣</b><strong>Бесплатный подбор</strong><span>за 15 минут</span></div>
    <div><b>▣</b><strong>Профессиональный монтаж</strong><span>от 1 дня</span></div>
    <div><b>◎</b><strong>Гарантия до 5 лет</strong><span>на оборудование и работы</span></div>
    <div><b>◇</b><strong>Честные цены</strong><span>без скрытых платежей</span></div>
  </div>
</section>

<section class="section home-control-grid" id="quick-selection">
  <div class="home-panel task-panel reveal">
    <p class="quick-eyebrow">Быстрый подбор</p>
    <h2>Подбор по задачам</h2>
    <div class="task-grid">
      <a class="task-card active task-apartment" href="/catalog?type=split">
        <span></span>
        <strong>Для квартиры</strong>
        <small>Спальня, гостиная, детская</small>
      </a>
      <a class="task-card task-home" href="/catalog?type=designer">
        <span></span>
        <strong>Для дома</strong>
        <small>Частные дома и коттеджи</small>
      </a>
      <a class="task-card task-office" href="/catalog?type=commercial">
        <span></span>
        <strong>Для офиса</strong>
        <small>Офисы, магазины и коммерция</small>
      </a>
      <a class="task-card task-server" href="/catalog?wifi=on">
        <span></span>
        <strong>Для сервера</strong>
        <small>Точное охлаждение оборудования</small>
      </a>
    </div>
    <a class="panel-link" href="/quiz">Пройти подбор за 1 минуту <span>→</span></a>
  </div>

  <div class="home-panel cost-panel reveal">
    <h2>Рассчитайте стоимость</h2>
    <p>Узнайте точную стоимость с установкой за 30 секунд</p>
    <form action="/calculator" method="get">
      <label>
        <span>Тип помещения</span>
        <select name="type">
          <option>Выберите тип</option>
          <option>Квартира</option>
          <option>Дом</option>
          <option>Офис</option>
        </select>
      </label>
      <label>
        <span>Площадь помещения</span>
        <select name="area">
          <option>25 м²</option>
          <option>35 м²</option>
          <option>50 м²</option>
        </select>
      </label>
      <button class="button button-primary" type="submit">Рассчитать стоимость <span>→</span></button>
    </form>
  </div>

  <div class="service-stack">
    <a class="home-panel service-card reveal" href="/installation">
      <span class="service-install"></span>
      <strong>Монтаж за 1 день</strong>
      <small>Установим быстро и аккуратно</small>
    </a>
    <a class="home-panel service-card reveal" href="/warranty">
      <span class="service-care"></span>
      <strong>Сервис и обслуживание</strong>
      <small>Поддержка 24/7 и регулярное ТО</small>
    </a>
  </div>
</section>

